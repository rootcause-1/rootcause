FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
RC_GRAPH=rc_live                 # rc_replay in the public deployment
RC_MODE=live                     # live | replay
RC_TICK_SECONDS=5
RC_WINDOW_SECONDS=60
PROMETHEUS_URL=http://prometheus:9090     # VERIFY service name/port inside demo network
DEMO_REPO_PATH=../opentelemetry-demo
FLAGD_CONFIG_PATH=${DEMO_REPO_PATH}/src/flagd/demo.flagd.json   # VERIFY
ANTHROPIC_API_KEY=
RC_LLM_MODEL=claude-sonnet-5-5
RC_AGENT_MODE=autopilot          # autopilot | llm
PAGER_WEBHOOK_URL=               # optional (Discord/Slack incoming webhook)
# Where the MCP server forwards write tools (propose/execute/verify/report)
RC_API_URL=http://rootcause-api:8000
# Where the LLM agent reaches the MCP server
RC_MCP_URL=http://rootcause-mcp:8811/mcp
# Replay scenario to auto-start in replay mode (empty = pick in UI)
RC_REPLAY_SCENARIO=
